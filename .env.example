# 1. Telegram Bot Token (Obtained from @BotFather)
SAAS_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# 2. Telegram Channel IDs (Must include the leading -100 prefix)
# VIP Private Channel (Where paid subscribers get auto-invited)
VIP_CHANNEL_ID="-1001234567890"

# Free Public Channel (Where teaser signals & market recaps are posted)
FREE_CHANNEL_ID="-1009876543210"
FREE_CHANNEL_USERNAME="PureQuantSignals"

# 3. Administrator Settings
# Your personal numeric Telegram User ID (Get from @userinfobot) to receive payment approval requests
ADMIN_TELEGRAM_ID="123456789"
SUPPORT_USERNAME="@PureQuantSupport"

# 4. Non-Custodial Crypto Deposit Addresses (USDT / USDC)
# Set these to your personal wallet deposit addresses (e.g., Trust Wallet, Ledger, Metamask, Phantom, etc.)
USDT_TRC20_WALLET="TXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
USDT_BEP20_WALLET="0xXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXx"
USDT_POLYGON_WALLET="0xXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXx"
USDT_SOLANA_WALLET="YourSolanaWalletAddressHere"
USDT_TON_WALLET="UQYourTonWalletAddressHere"

# 5. Optional Webhook Port (Leave blank to use robust long-polling)
PORT=8080
